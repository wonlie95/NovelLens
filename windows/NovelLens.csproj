<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>小说伴读</AssemblyName>
    <RootNamespace>NovelLens</RootNamespace>
    <Version>1.11.0</Version>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3650.58" />
    <EmbeddedResource Include="..\shared\index.html" Link="index.html" />
    <EmbeddedResource Include="..\shared\enhancements.js" LogicalName="Assets.enhancements.js" />
    <EmbeddedResource Include="..\shared\enhancements.css" LogicalName="Assets.enhancements.css" />
    <EmbeddedResource Include="..\shared\NotoSansJP-VF.ttf" LogicalName="Assets.NotoSansJP-VF.ttf" />
    <EmbeddedResource Include="..\shared\OFL.txt" LogicalName="Assets.OFL.txt" />
    <EmbeddedResource Include="..\shared\furigana.js" LogicalName="Assets.furigana.js" />
    <EmbeddedResource Include="..\shared\furigana.css" LogicalName="Assets.furigana.css" />
    <EmbeddedResource Include="..\shared\speech.js" LogicalName="Assets.speech.js" />
    <EmbeddedResource Include="..\shared\speech.css" LogicalName="Assets.speech.css" />
    <EmbeddedResource Include="..\shared\kuromoji.js" LogicalName="Assets.kuromoji.js" />
    <EmbeddedResource Include="..\shared\kuromoji-LICENSE.txt" LogicalName="Assets.kuromoji-LICENSE.txt" />
    <EmbeddedResource Include="..\shared\kuromoji-NOTICE.md" LogicalName="Assets.kuromoji-NOTICE.md" />
    <EmbeddedResource Include="..\shared\dict\*" LogicalName="Assets.dict/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
